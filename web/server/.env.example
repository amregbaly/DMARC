PORT=5000
NODE_ENV=production
# OpenSearch connection settings
OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USER=sentinel_reader
OPENSEARCH_PASSWORD=your_secure_opensearch_password_here
INDEX_PATTERN=dmarc_aggregate-*

# Optional: Path to custom CA certificate for OpenSearch cluster
# OPENSEARCH_CA_CERT=/path/to/opensearch-ca.pem
# Set to true only in development/testing if using self-signed certificates
OPENSEARCH_ALLOW_SELF_SIGNED=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Authentication: Strong JWT signing secret (minimum 32 characters required)
JWT_SECRET=your_minimum_32_character_jwt_secret_key_here

# Initial admin setup (optional; auto-generated with random password if omitted on first boot)
# INITIAL_ADMIN_EMAIL=admin@dmarcsentinel.local
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=your_initial_admin_password
